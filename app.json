{
  "expo": {
    "name": "Clube_Quinze_App",
    "slug": "ProjetoQuinze",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andre0luis.clubequinze",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.andre0luis.clubequinze",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "scheme": "clubequinze",
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos acessar sua galeria para anexar imagens aos posts e perfil."
        }
      ],
      [
        "expo-notifications"
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65023eb1-bfbe-480c-9781-4441576253d9"
      }
    },
    "owner": "andre0luis"
  }
}
