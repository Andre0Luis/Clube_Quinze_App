{
  "expo": {
    "name": "Clube_Quinze_App",
    "slug": "ProjetoQuinze",
    "scheme": "com.andre0luis.ProjetoQuinze",
    "version": "1.0.6",
    "icon": "./assets/images/icon.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65023eb1-bfbe-480c-9781-4441576253d9"
      }
    },
    "owner": "andre0luis",
    "ios": {
      "bundleIdentifier": "com.andre0luis.ProjetoQuinze",
      "buildNumber": "17",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.andre0luis.ProjetoQuinze"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Clube Quinze precisa de acesso à sua galeria para você selecionar fotos para o seu perfil e publicações.",
          "cameraPermission": "O Clube Quinze precisa da câmera para você tirar fotos e compartilhar na comunidade."
        }
      ]
    ]
  }
}
